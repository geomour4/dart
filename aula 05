// // 5) Crie uma lista de notas e calcule a média da turma.

void main() {
List<double> notas = [10, 7.5, 9, 6.0, 5.5];
double soma = 0.0;

for (double nota in notas) {
soma += nota;
}
double media = soma / notas.length;

print('Notas da turma: $notas');
print('Total de alunos: ${notas.length}');
print('Média final da turma: ${media}');
}

