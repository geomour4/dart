1. Atividade 

// Crie uma classe chamada Produto com os seguintes atributos:

// nome
// preco
// quantidade

// Crie um construtor com this.

// Crie um método chamado mostrarDados() que exiba:

// Nome do produto
// Preço
// Quantidade

// Crie também um método chamado calcularTotal() que mostre o valor total em estoque:

// preco * quantidade

// No main, crie pelo menos 3 produtos diferentes e chame os métodos.

class Produto{
String nome;
double preco;
int quantidade;

Produto(this.nome,this.preco,this.quantidade);
void mostrarDados() {
  print('Produto: ${this.nome}');
  print('Preço: ${this.preco}');
  print('Quantidade: ${this.quantidade}');
}

void calcularTotal() {
  double total = this.preco * this.quantidade;
  print('Valor total em estoque: ${total}');
  }
}
void main() {
Produto prod1 = Produto('Notebook', 3500.00, 5);
Produto prod2 = Produto('Smartphone', 1800.50, 10);
Produto prod3 = Produto('Fone Bluetooth', 150.00, 25);

prod1.mostrarDados();
prod1.calcularTotal();

prod2.mostrarDados();
prod2.calcularTotal();

prod3.mostrarDados();
prod3.calcularTotal();
}

