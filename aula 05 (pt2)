import 'dart:io';

// Exercício 1 — Crie uma lista chamada nomes contendo 5 nomes de pessoas.

// Depois, faça:
// 1. Mostre todos os nomes usando for.
// 2. Mostre todos os nomes usando forEach.
// 3. Mostre a quantidade total de nomes na lista.
// 4. Adicione mais 2 nomes.
// 5. Mostre a lista atualizada.

void main() {

  List<String> nomes = ['Carol', 'Gabi', 'Lucas', 'Guilherme', 'Davi'];
  for (int i = 0; i < nomes.length; i++) {
    print(nomes[i]);
  }
  nomes.forEach((nome) => print(nome));
  print('Total de nomes: ${nomes.length}');
  nomes.addAll(['Fernanda', 'Gabriel']);
  print(nomes);
  
}

// Exercício 2 — Lista de números

// Crie uma lista com os seguintes números:

// [4, 8, 15, 16, 23, 42]

// Depois, faça:

// Percorra a lista usando for.
// Mostre cada número com sua posição.
// Mostre apenas os números maiores que 10.
// Mostre a quantidade total de elementos da lista

void main() {

  List<int> numeros = [4, 8, 15, 16, 23, 42];
  
  for (int i = 0; i < numeros.length; i++) {
    print('Posição $i: ${numeros[i]}');

    if (numeros[i] > 10) {
      print('${numeros[i]} é maior que 10');
    }
  }

  print('Quantidade total de elementos: ${numeros.length}');
}

// Exercício 3 — Removendo elementos pelo valor

// Crie uma lista de frutas com os seguintes valores:
// ['Maçã', 'Banana', 'Uva', 'Laranja', 'Melancia']

// Depois, faça:

// Mostre a lista original.
// Remova a fruta "Uva" usando remove.
// Mostre a lista após a remoção.
// Adicione uma nova fruta.
// Mostre a lista final usando forEach.

void main() {

  List<String> frutas = ['Maçã', 'Banana', 'Uva', 'Laranja', 'Melancia'];
  print(frutas);

  frutas.remove('Uva');

  print(frutas);

  frutas.add('Morango');
  frutas.forEach((fruta) => print(fruta));
}


// Exercício 4 — Removendo elementos pelo índice

// Crie uma lista chamada disciplinas com pelo menos 5 disciplinas.
// Depois, faça:

// Mostre todas as disciplinas com suas posições.
// Remova a disciplina da posição 2 usando removeAt.
// Mostre a lista atualizada.
// Mostre o novo tamanho da lista.

void main() {
  
  List<String> disciplinas = ['Matemática', 'Português', 'História', 'Geografia', 'Biologia'];


  for (int i = 0; i < disciplinas.length; i++) {
    print('Posição $i: ${disciplinas[i]}');
  }

  String disciplinaRemovida = disciplinas.removeAt(2);
  print('Removendo o item "$disciplinaRemovida" foi removido.');

  print(disciplinas); 

  print('Total de disciplinas restantes: ${disciplinas.length}');
}


// Exercício 5 — Busca em lista
// Crie uma lista com nomes de alunos.
// Depois, faça:

// Escolha um nome para buscar.
// Use for para procurar esse nome na lista.
// Se encontrar, mostre a mensagem:
// Aluno encontrado na posição X.
// Se não encontrar, mostre:
// Aluno não encontrado.


void main() {
  List<String> alunos = ['Lucas', 'Carol', 'Gabi', 'Davi', 'Guilherme'];
  String alunoBuscado = 'Davi';
  int posicaoEncontrada = -1;

  for (int i = 0; i < alunos.length; i++) {
    if (alunos[i] == alunoBuscado) {
      posicaoEncontrada = i; 
      break; 
    }
  }

  if (posicaoEncontrada != -1) {
    
    print('Aluno encontrado na posição $posicaoEncontrada.');
  } else {
    
    print('Aluno não encontrado.');
  }
}
